# minimax-music environment variables. These override config.yaml values.
# Copy to .env and export, or set inline when launching.

# HTTP listen address.
MINIMAX_ADDR=:8080

# MiniMaxi web client (required).
MINIMAX_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
MINIMAX_OP_TICKET=
MINIMAX_UUID=c7140fab-2118-47cc-8941-c4d69c31c832
MINIMAX_DEVICE_ID=
MINIMAX_LANG=zh-Hans
# MINIMAX_HTTP_TIMEOUT=30s
# MINIMAX_WS_TIMEOUT=5m

# Outbound proxy (empty = direct). Supports http://, https://, socks5://, socks5h://.
MINIMAX_PROXY_URL=socks5h://127.0.0.1:1080
MINIMAX_PROXY_USERNAME=
MINIMAX_PROXY_PASSWORD=
MINIMAX_PROXY_INSECURE=false
